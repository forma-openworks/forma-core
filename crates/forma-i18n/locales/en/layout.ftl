# Blender-style composite interface: areas with editors, corner gestures, detached windows.

dock-editor-type = Editor type
dock-empty-title = Nothing here yet
dock-empty-hint = Choose which editor to open here
dock-empty-button = Choose editor

dock-corner-hint = Drag inward to split, into a neighbouring area to join, into any other area to move.
    Ctrl swaps the areas, Shift opens a copy in a new window.
dock-gesture-none = Release here to change nothing
dock-gesture-split = Split area
dock-gesture-join = Join: the darkened area will disappear
dock-gesture-swap = Swap areas
dock-gesture-dock = Move the area here
dock-gesture-replace = Move the area in place of this one
dock-gesture-keys = Tab rotates the line · Ctrl swaps · Esc cancels
dock-split-hint = Click to split · Tab rotates the line · Esc cancels

dock-split-vertical = Vertical split
dock-split-horizontal = Horizontal split
dock-join-left = Join into the left area
dock-join-right = Join into the right area
dock-join-up = Join into the upper area
dock-join-down = Join into the lower area
dock-join-unavailable = Only two areas that share a whole edge can be joined
dock-swap = Swap areas
dock-maximize = Maximize area
dock-restore = Restore area
dock-detach = Move area to a separate window
dock-duplicate-window = Duplicate area into a new window
dock-attach-window = Return window to the main one
dock-close-area = Close area
