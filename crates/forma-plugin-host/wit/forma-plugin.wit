/// API плагинов Forma, версия 1.3: что программа даёт code плагина (host) и что code плагина
/// умеет сам (экспорты мира `plugin`). Плагин — компонент WebAssembly (`wasm32-wasip2`),
/// работает в песочнице и видит только то, что разрешено в `[permissions]` его манифеста.
///
/// Тексты сложной формы (контекст, дерево элементов, события) передаются JSON-строками: так
/// их можно расширять без новой версии API, а SDK `forma-plugin-api` даёт к ним типы. Дерево
/// элементов описано в crate `forma-plugin-ui`.
package forma:plugin@1.3.0;

/// Общие типы.
interface types {
    /// Строка журнала.
    enum level {
        debug,
        info,
        warn,
        error,
    }

    /// Строка списка папки.
    record entry {
        name: string,
        dir: bool,
    }

    /// Просьба о подсказке при наведении: `hover` — id подсказки из манифеста, `text` — текст
    /// под указателем (абзац или строка), `offset` — символ под указателем (в символах
    /// Unicode, не в байтах), `note` — путь заметки или файла от корня.
    record hover-request {
        hover: string,
        text: string,
        offset: u32,
        note: string,
    }

    /// Подсказка: к каким символам `text` она относится (`start..end`) и что показать
    /// (markdown).
    record hover-result {
        start: u32,
        end: u32,
        markdown: string,
    }

    /// Что случилось с запущенной программой (с версии 1.2).
    enum job-stream {
        /// Строка её вывода.
        stdout,
        /// Строка вывода ошибок.
        stderr,
        /// Программа завершилась (или её остановили): код — в `code`.
        exit,
    }

    /// Событие задачи `job`: строка вывода целиком (без перевода строки, сколь угодно
    /// длинная, UTF-8 с заменой битых байтов) или завершение.
    record job-event {
        job: u32,
        kind: job-stream,
        text: string,
        code: option<s32>,
    }
}

/// Что программа даёт code плагина. Функции с правами проверяют `[permissions]` манифеста
/// и без них возвращают ошибку.
interface host {
    use types.{level, entry};

    /// Сообщение в журнал программы.
    log: func(level: level, message: string);

    /// Уведомление внизу окна.
    notify: func(text: string, error: bool);

    /// Текстовый файл хранилища или проекта: путь от корня, через `/`. Право `vault:read`.
    read-file: func(path: string) -> result<string, string>;

    /// Двоичный файл хранилища или проекта (модели, картинки). Право `vault:read`.
    read-bytes: func(path: string) -> result<list<u8>, string>;

    /// Что лежит в папке хранилища (`""` — корень). Право `vault:read`.
    list-dir: func(path: string) -> result<list<entry>, string>;

    /// Записать текстовый файл хранилища. Право `vault:write`.
    write-file: func(path: string, text: string) -> result<_, string>;

    /// Своё хранилище «ключ — значение» плагина, сохраняется между запусками. Право `data`.
    data-get: func(key: string) -> option<string>;
    data-set: func(key: string, value: string) -> result<_, string>;

    /// Показать панель плагина `panel` (id из манифеста): открыть, если её нет, и нарисовать
    /// заново (`render-panel`).
    open-panel: func(panel: string);

    /// Нарисовать панель заново: у плагина поменялось то, что она показывает.
    refresh-panel: func(panel: string);

    /// Открыть заметку или файл по цели ссылки, как `[[цель#раздел]]` в заметке.
    open-link: func(target: string);

    /// Значение настройки плагина (с версии 1.1) — JSON-текст: из `settings.json` программы,
    /// если оно там есть и подходит схеме из манифеста, иначе значение по умолчанию. Только
    /// свои ключи (`<id плагина>.…`); чужой или незнакомый — ничего.
    setting: func(key: string) -> option<string>;

    /// Запустить программу (с версии 1.2): только из `[permissions] process` — по имени
    /// (`learn`) или полным путём к файлу с этим именем (`…/blender.exe`). `cwd` — папка
    /// хранилища (`""` — корень) или связанная папка (право `linked:read`). Программа
    /// работает в фоне, её вывод приходит строками в `job-events`. Возвращает номер задачи.
    spawn: func(program: string, args: list<string>, cwd: string) -> result<u32, string>;

    /// Остановить свою задачу вместе со всеми программами, которые она запустила.
    cancel: func(job: u32);

    /// Передать текст на вход своей задачи.
    write-stdin: func(job: u32, text: string) -> result<_, string>;

    /// Отметить пункт раздела «Практика» заметки по жирному началу пункта
    /// (`- [ ] **Свой package.** …`); уже отмеченный остаётся как был. Правку делает
    /// программа (несохранённые правки открытой заметки не теряются). Право `vault:write`.
    toggle-task: func(note: string, title: string) -> result<_, string>;

    /// Дописать markdown в конец заметки; нет заметки — создать её (и папки). Право
    /// `vault:write`.
    append-to-note: func(note: string, markdown: string) -> result<_, string>;

    /// Дописать markdown в конец раздела заметки с этим заголовком. Право `vault:write`.
    append-to-section: func(note: string, heading: string, markdown: string) -> result<_, string>;

    /// Связанные папки хранилища полными путями (практика курса, связанные курсы). Право
    /// `linked:read`; без него — пусто. Внутри них работают `read-file`, `read-bytes`,
    /// `list-dir` (полный путь или `linked:<имя>/…`) и `cwd` у `spawn`.
    linked-dirs: func() -> list<string>;

    /// Нарисовать заново все блоки заметок этого плагина (с версии 1.3): поменялось то, что
    /// они показывают (пришёл итог проверки, который плагин ждал от своей программы).
    refresh-blocks: func();

    /// Открыть в другой программе Forma (с версии 1.3), только из `[permissions] apps`:
    /// `app` — `instar` или `holotype`; `root` — папка проекта или хранилища (от корня,
    /// `linked:<имя>/…` или полный путь внутри хранилища или связанной папки); `open` — что
    /// открыть в ней: файл (полный путь или от `root`, можно с `:строка`) или заметку
    /// (`цель#раздел`); пусто — только саму папку. Если программа с этой папкой уже открыта,
    /// она получает `open` и выходит вперёд, иначе программа запускается.
    open-app: func(app: string, root: string, open: string) -> result<_, string>;
}

/// Плагин API 1.0–1.1: по этому миру программа загружает и плагины, собранные до 1.2.
world plugin-base {
    import host;
    use types.{hover-request, hover-result};

    /// Плагин загружен. `context` — JSON: `{"app": "holotype", "language": "ru",
    /// "root": true}` (есть ли открытое хранилище или проект).
    export activate: func(context: string) -> result<_, string>;

    /// В хранилище поменялись файлы (пути от корня; пустой список — поменяться могло что
    /// угодно) — можно перечитать своё.
    export changed: func(paths: list<string>);

    /// Подсказка при наведении; ничего — подсказки нет.
    export hover: func(request: hover-request) -> option<hover-result>;

    /// Блок заметки (` ```lang `) → дерево элементов (JSON), которое рисует программа.
    export render-block: func(lang: string, source: string, context: string) -> result<string, string>;

    /// Команда из манифеста. `args` — JSON: где её вызвали (`from`: `menu`, `key`, `block`,
    /// `panel`), заметка, выделенный текст, заголовок над ним, абзац и `args` кнопки. Ответ —
    /// JSON (или пустая строка).
    export command: func(id: string, args: string) -> result<string, string>;

    /// Панель плагина → дерево элементов (JSON). `context` — JSON: текущая заметка.
    export render-panel: func(panel: string, context: string) -> result<string, string>;

    /// Событие элемента панели (JSON: `id`, `kind`, `value`) → новое дерево панели.
    export panel-event: func(panel: string, event: string, context: string) -> result<string, string>;
}

/// Плагин API 1.2–1.3: всё, что у `plugin-base`, события своих задач и (с 1.3) события
/// блоков заметок. Программа находит эти экспорты по имени: у плагинов старых версий их нет.
world plugin {
    include plugin-base;
    use types.{job-event};

    /// События задач, запущенных `spawn` (строки вывода, завершение), — пачкой, в начале
    /// кадра программы. Обновить панель — `refresh-panel`.
    export job-events: func(events: list<job-event>);

    /// Событие элемента блока заметки (с версии 1.3; JSON: `id`, `kind`, `value`) → новое
    /// дерево этого блока. `lang` и `source` — какой блок, `context` — как у `render-block`.
    export block-event: func(lang: string, source: string, event: string, context: string) -> result<string, string>;
}
